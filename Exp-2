# 5 � 4 Matrix (Filled by Row)
matrix1 <- matrix(1:20, nrow = 5, ncol = 4, byrow = TRUE)

rownames(matrix1) <- c("R1", "R2", "R3", "R4", "R5")
colnames(matrix1) <- c("C1", "C2", "C3", "C4")

cat("5 x 4 Matrix (Filled by Row):\n")
print(matrix1)


# 3 � 3 Matrix (Filled by Column)
matrix2 <- matrix(1:9, nrow = 3, ncol = 3, byrow = FALSE)

rownames(matrix2) <- c("R1", "R2", "R3")
colnames(matrix2) <- c("C1", "C2", "C3")

cat("\n3 x 3 Matrix (Filled by Column):\n")
print(matrix2)


# 2 � 2 Matrix (Filled by Row)
matrix3 <- matrix(1:4, nrow = 2, ncol = 2, byrow = TRUE)

rownames(matrix3) <- c("R1", "R2")
colnames(matrix3) <- c("C1", "C2")

cat("\n2 x 2 Matrix (Filled by Row):\n")
print(matrix3)
